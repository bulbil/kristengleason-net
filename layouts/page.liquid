<!DOCTYPE html>
<html lang="en" style="--color--contrast:{{ site.contrast-color }};">

{% include "head.html" %}

<!--
Illustration inspiration: Stone Age Balkan egg designs reproduced in *A Druid Missal Any* (1983)
https://archive.org/details/bim_early-english-books-1641-1700_a-druid-missal-any_ia40330214-21
-->

<body>
    {% include "border.html" class: "top" img: "/assets/img/balkan-egg-designs-1.jpg,/assets/img/balkan-egg-designs-2.jpg" %}
    {% include "border.html" class: "double" img: "/assets/img/stavchany-stone-idol.jpg" %}
    <div id="container">
        {% for card in collections.content %}
        <section>
        {{ card.content }}
        </section>
        {% include "border.html" class: "content" img: card.data.border_img %}
        {% endfor %}
        </div>
    {% include "border.html" class: "double" img: "/assets/img/night.jpg" %}
</body>

<script>
window.onload = (event) => {
  document.querySelector('body').classList.add('loaded')
};
</script>
</html>